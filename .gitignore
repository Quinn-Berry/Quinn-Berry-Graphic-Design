# Staging area only — never commit unsorted drops
_inbox/*
!_inbox/.gitkeep

.DS_Store

# Generated PDFs stay out of the repo. The PDF edition is a separate deliverable
# from the site — rebuild it with scripts/make_pdf.sh rather than committing an
# 8 MB binary that churns on every content change.
*.pdf

# Design-tool exports. These arrive as ~100 MB bundles carrying their own
# duplicate copy of the artwork; the real assets belong in images/ via the
# manifest. Keep the bundle locally, out of git.
*.zip

# Local tooling state, not part of the site
.claude/
.remember/

# Design-tool source files. Same reasoning as the export bundles above: the
# editable project lives locally, the site ships the rendered PNG.
*.aep
*.ai
